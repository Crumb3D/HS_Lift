<configs>
	<set xpath="/windows/window[@name='windowRadial']/rect[@name='radialPanel']/@repeat_count">32</set>
	<append xpath="/windows">
		<window name="HUDHSLift" pos="-540,110" width="528" height="188" anchor="Right" depth="15" controller="HSLiftHud, HSLift">
			<rect width="528" height="188" visible="{show}">
				<sprite depth="1" pos="0,0" width="528" height="188" sprite="menu_empty" color="0,0,0,150" type="sliced"/>
				<label depth="2" pos="10,-8" width="508" height="172" font_size="15" justify="left" upper_case="false" color="255,255,255,230" text="{info}"/>
			</rect>
		</window>
	</append>
	<append xpath="/windows">
		<window name="HSLiftHandbook" anchor="Center" pos="-760,480" width="1520" height="960" cursor_area="true" depth="300" controller="HSLiftHandbookWindow, HSLift">
			<rect name="header" pos="0,0" width="1520" height="72" depth="1">
				<headerbg />
				<label depth="2" pos="20,-12" width="1480" height="52" font_size="44" justify="left" upper_case="false" color="255,248,236" text="{title}"/>
			</rect>
			<rect name="content" pos="0,-72" width="1520" height="888" depth="1">
				<boxbg />
				<rect name="scrollArea" pos="24,-20" width="1472" height="760" depth="2" on_scroll="true">
					<defaultscrollbar />
					<scrollview pos="0,0" width="1420" height="760" clippingsoftness="0,12" resetpositiononopen="true">
						<label name="body" depth="4" pos="8,0" width="1380" height="400" font_size="40" justify="left" upper_case="false" pivot="topleft" overflow="resizeheight" color="255,255,255" text="{body}"/>
					</scrollview>
				</rect>
				<simplebutton name="btnClose" pos="1180,-800" width="300" height="64" font_size="36" caption="Close"/>
			</rect>
		</window>
	</append>
</configs>
