<configs>
	<set xpath="/windows/window[@name='windowRadial']/rect[@name='radialPanel']/@repeat_count">32</set>
	<append xpath="/windows">
		<window name="HUDHSLift" pos="-540,110" width="528" height="188" anchor="Right" depth="15" controller="HSLiftHud, HSLift">
			<rect width="528" height="188" visible="{show}">
				<sprite depth="1" pos="0,0" width="528" height="188" sprite="menu_empty" color="0,0,0,150" type="sliced"/>
				<label depth="2" pos="10,-8" width="508" height="172" font_size="15" justify="left" upper_case="false" color="255,255,255,230" text="{info}"/>
			</rect>
		</window>
	</append>
</configs>
