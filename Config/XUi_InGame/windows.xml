<configs>
	<append xpath="/windows">
		<window name="HUDHSLift" pos="160,30" width="160" height="104" anchor="Center" depth="15" controller="HSLiftHud, HSLift">
			<rect width="160" height="104" visible="{show}">
				<sprite depth="1" pos="0,0" width="160" height="104" sprite="menu_empty" color="0,0,0,150" type="sliced"/>
				<label depth="2" pos="8,-6" width="144" height="92" font_size="14" justify="left" upper_case="false" color="255,255,255,230" text="{info}"/>
			</rect>
		</window>
	</append>
</configs>
